# VenueTwin runs without these values by saving projects locally.
# Add a Supabase project later to enable accounts and cloud persistence.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local Studio Pilot. Server-only: NEVER prefix this key with VITE_.
# Set these in .env.local, then restart npm run dev.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional local Blender executable path. macOS defaults to:
# /Applications/Blender.app/Contents/MacOS/Blender
# Windows/Linux: set the full executable path if blender is not on PATH.
BLENDER_PATH=

# Public hosted frontend configuration (server secrets belong in deploy/api.env).
VITE_PILOT_API_URL=
VITE_OPERATOR_NAME=
VITE_SUPPORT_EMAIL=
VITE_PRIVACY_URL=
VITE_TERMS_URL=
