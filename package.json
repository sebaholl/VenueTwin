{
  "name": "venuetwin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "predev": "node scripts/prepare-demo.mjs",
    "prebuild": "node scripts/prepare-demo.mjs",
    "demo:prepare": "node scripts/prepare-demo.mjs",
    "demo:host": "node scripts/serve-demo.mjs",
    "build:server": "node scripts/build-server.mjs",
    "start:server": "node dist-server/main.mjs",
    "postbuild": "node scripts/security-headers.mjs",
    "test:python": "python3 -m unittest discover -s scripts/blender -p \"test_*.py\"",
    "test:blender": "node scripts/smoke-blender.mjs",
    "demo": "vite --host 127.0.0.1 --port 5173",
    "demo:viewer": "npm run build:managed:demo && node scripts/serve-managed.mjs",
    "showcase:build": "python3 scripts/build-showcase.py",
    "showcase:verify": "node scripts/verify-showcase.mjs",
    "reduta:prepare": "node scripts/prepare-reduta-study.mjs",
    "build:managed": "tsc -b && node --experimental-strip-types scripts/managed-release.mjs",
    "build:managed:demo": "tsc -b && node --experimental-strip-types scripts/managed-release.mjs --demo",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "three": "^0.180.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "openskp": "^1.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
